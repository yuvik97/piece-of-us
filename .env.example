# ── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────────────────
# Leave empty to run in DEMO MODE (in-memory store, resets on restart).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments ────────────────────────────────────────────────────────────
# mock   = built-in test checkout (default, no real money)
# paypal = PayPal Orders v2 (use PAYPAL_ENV=sandbox until approved for live)
PAYMENT_PROVIDER=mock
PAYMENT_TEST_MODE=true
MOCK_WEBHOOK_SECRET=change-me-long-random-string

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ── Admin ───────────────────────────────────────────────────────────────
# Single-owner fallback login (username: owner). Prefer ADMIN_ACCOUNTS.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=change-me-another-long-random-string

# Hash salt for IP addresses stored with submissions (abuse prevention)
IP_HASH_SALT=change-me-too

# ── Content moderation (server-only) ───────────────────────────────────
# Claude reads the image (incl. text inside it, any language) + title/description/name.
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-sonnet-5-5
# Optional second opinion on core harm categories (free endpoint).
OPENAI_API_KEY=
MODERATION_TIMEOUT_MS=25000
# Demo mode only: approve on local checks when no AI key is set. Ignored once Supabase is configured.
MODERATION_DEMO_LOCAL_ONLY=true

# ── Notifications (optional; contributors may leave an e-mail) ─────────
RESEND_API_KEY=
NOTIFY_FROM=PIECE OF US <hello@your-domain>

# ── Admin accounts (role-based) ────────────────────────────────────────
# Generate entries with: npx tsx scripts/hash-password.ts <username> <admin|moderator> <password>
ADMIN_ACCOUNTS=
# ── Scheduled jobs (expire holds, data retention) ──────────────────────
CRON_SECRET=
